.ds \*[locale]-june czerwiec\"                               [me,mm,ms]
.ds \*[locale]-le SPIS RÓWNAÑ\"                              [mm]
.ds \*[locale]-letapp Zaakceptowano:\"                       [mm]
.ds \*[locale]-letat Uwaga:\"                                [mm]
.ds \*[locale]-letcn Poufne\"                                [mm]
.ds \*[locale]-letdate Data\"                                [mm]
.ds \*[locale]-letfc Z wyrazami szacunku,\"                  [mm]
.ds \*[locale]-letns!0 Kopia do\"                            [mm]
.ds \*[locale]-letns!1 Kopia (oraz za³±cznik) do\"           [mm]
.ds \*[locale]-letns!10 Kopia (oraz za³±czniki) do\"         [mm]
.ds \*[locale]-letns!11 Kopia (bez za³±czników) do\"         [mm]
