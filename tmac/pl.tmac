.ds \*[locale]-letns!3 Za³±cznik\"                           [mm]
.ds \*[locale]-letns!4 Za³±czniki\"                          [mm]
.ds \*[locale]-letns!5 Przesy³ka\"                           [mm]
.ds \*[locale]-letns!6 Przesy³ki\"                           [mm]
.ds \*[locale]-letns!7 W oddzielnej przesy³ce\"              [mm]
.ds \*[locale]-letns!8 Adresat\"                             [mm]
.ds \*[locale]-letns!9 Nota dla\"                            [mm]
.ds \*[locale]-letns!copy Kopia \"                           [mm]
.ds \*[locale]-letns!to  do\"                                [mm]
.ds \*[locale]-letrn W nawi±zaniu do:\"                      [mm]
.ds \*[locale]-letsa Dla zainteresowanych:\"                 [mm]
.ds \*[locale]-letsj TEMAT:\"                                [mm]
.ds \*[locale]-lf SPIS ILUSTRACJI\"                          [mm]
.ds \*[locale]-licon ZAWARTO¦Æ\"                             [mm]
.ds \*[locale]-liec Równanie\"                               [mm]
.ds \*[locale]-liex Za³±cznik\"                              [mm]
.ds \*[locale]-lifg Rysunek\"                                [mm]
.ds \*[locale]-litb Tabela\"                                 [mm]
.ds \*[locale]-lt SPIS TABEL\"                               [mm]
.ds \*[locale]-lx SPIS ZA£¡CZNIKÓW\"                         [mm]
.ds \*[locale]-man-section1 Komendy ogólne\"                 [man]
.ds \*[locale]-man-section2 Wywo³ania systemowe\"            [man]
.ds \*[locale]-man-section3 Funkcje biblioteki C\"           [man]
.ds \*[locale]-man-section4 Pliki specjalne\"                [man]
.ds \*[locale]-man-section5 Formaty plików\"                 [man]
.ds \*[locale]-man-section6 Gry\"                            [man]
.ds \*[locale]-man-section7 Ró¿ne\"                          [man]
