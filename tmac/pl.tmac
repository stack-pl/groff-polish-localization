.ds \*[locale]-references Materia³y ¼ród³owe\"               [ms]
.ds \*[locale]-revision_string Rewizja\"                     [mom]
.ds \*[locale]-rp MATERIA£Y ¬RÓD£OWE\"                       [mm]
.ds \*[locale]-saturday sobota\"                             [me,mm]
.ds \*[locale]-september wrzesieñ\"                          [mm]
.ds \*[locale]-sunday niedziela\"                            [me,mm]
.ds \*[locale]-thursday czwartek\"                           [me,mm]
.ds \*[locale]-toc SPIS TRE¦CI\"                             [ms]
.ds \*[locale]-toc_header_string Spis tre¶ci\"               [mom]
.ds \*[locale]-tuesday wtorek\"                              [me,mm]
.ds \*[locale]-wednesday ¶roda\"                             [me,mm]
.
.
.\" Activate the translations
.
.mso trans.tmac
.
.
.\" ms package
.if r GS \{\
.	\" update the date
.	ds DY \n[dy] \*[MO] \n[year]
.	\" set hyphenation mode
.	nr HY 2
.\}
.
.
.\" mm package
.if d PH \{\
.	ds cov*local-date-format \En[dy] \E*[MO\En[mo]] \En[year]
.	als cov*mt0-authors \*[locale]-attribute_string
.	als cov*mt0-date \*[locale]-letdate
.	ds cov*mt0-subject Temat\"
.	ds cov*mt0-txt!1 NOTATKA DO AKT\"
.	ds cov*mt0-txt!2 UWAGI TECHNICZNE\"
.	ds cov*mt0-txt!3 ZALECENIA ADMINISTRACYJNE\"
.	ds cov*mt0-org Wydz.\"
.	ds cov*mt0-ext \[hy]\"
.	ds cov*mt05-charge-case Sygnatura:\"
.	ds cov*mt05-file-case Sprawa:\"
.	ds Pg_type!1 OFICJALNA KOPIA
.	ds Pg_type!2 KOPIA ROBOCZA
.	ds Pg_type!3 W\ E\ R\ S\ J\ A\ \ \ R\ O\ B\ O\ C\ Z\ A
.	ds Pg_type!4 W\ E\ R\ S\ J\ A\ \ \ R\ O\ B\ O\ C\ Z\ A
.	\"Alt version of mm's GETR that removes a period just after chapter" 
.	de GETRND
.	if \\n[.$]<1 .@error \\$0: expected an argument
.   ie !r qrf*pass .tm \\$0: no .INITR in this file" \" XXX: .@error?
.	el \{\
.		GETHN \\$1 Qrfh
.		if \\n[H1dot]>0 \
.			chop Qrfh
.		GETPN \\$1 Qrfp
\\*[Qrf]
.	\}
..
.
.\" Default encoding
.mso latin2.tmac
.
.ss 12 0
.
.\" Set up hyphenation.
.
.\" Polish hyphenation (\lefthyphenmin=2, \righthyphenmin=3)
.nr \*[locale]*hyphenation-mode-base 1
.nr \*[locale]*hyphenation-mode-trap 2
.
.ie \n[locale*use-trap-hyphenation-mode] \
.   hy \n[\*[locale]*hyphenation-mode-trap]
.el \
.   hy \n[\*[locale]*hyphenation-mode-base]
.
.hy
.
.rr locale*use-trap-hyphenation-mode
.
.hcode ± ±  ¡ ±
.hcode æ æ  Æ æ
.hcode ê ê  Ê ê
.hcode ³ ³  £ ³
.hcode ñ ñ  Ñ ñ
.hcode ó ó  Ó ó
.hcode ¶ ¶  ¦ ¶
.hcode ¼ ¼  ¬ ¼
.hcode ¿ ¿  ¯ ¿
.
.hla pl
.hpf hyphen.pol
.hpfa hyphenex.pol
.
.
.\" man package
.if d an \
.	an*reset-hyphenation-mode
.
.
.\" me package
.if d @R \{\
.	ds _td_format \En(dy \E*(mo \En(y4
.	ld
.\}
.
.
.cp \n[*groff_pl_tmac_C]
.do rr *groff_pl_tmac_C
.
